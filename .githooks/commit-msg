#!/usr/bin/env bash
# Rejects commit messages that reference AI coding tools or include
# Co-authored-by trailers for them. Enable with:
#   git config core.hooksPath .githooks
set -euo pipefail

commit_msg_file="$1"
commit_msg="$(cat "$commit_msg_file")"

# "Cursor" is checked case-sensitively and separately: matched
# case-insensitively, it collides with the ordinary English word "cursor".
forbidden_pattern_ci='\b(Co-authored-by|Claude|Anthropic|Codebuff|Generated with)\b'
forbidden_pattern_cursor='\bCursor\b'

if printf '%s' "$commit_msg" | grep -Eiq "$forbidden_pattern_ci" \
  || printf '%s' "$commit_msg" | grep -Eq "$forbidden_pattern_cursor"; then
  echo "commit-msg hook: commit message must not reference AI tools or contain a Co-authored-by trailer for one." >&2
  exit 1
fi
